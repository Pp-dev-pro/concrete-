# Copy this file to .env and fill in your own credentials.
# Do not commit .env or expose these values in browser JavaScript.
PORT=3000
ZOHO_ACCESS_TOKEN=replace_with_your_zoho_oauth_access_token
ZOHO_CATALYST_ORG=60092144905
ZOHO_ENVIRONMENT=Development

# Endpoint keys for each QuickML model endpoint
XGBOOST_ENDPOINT_KEY=replace_with_xgboost_endpoint_key
NEXT_REGRESSION_ENDPOINT_KEY=replace_with_second_model_endpoint_key

# Both models currently use the endpoint URL supplied in your request.
ZOHO_QUICKML_PREDICT_URL=https://api.catalyst.zoho.in/quickml/v1/project/84405000000016025/endpoints/predict
